# Signal · BluOr Earnings & Catalyst Dashboard — env template
# Copy to .env.local for dev; set in the Vercel dashboard for production.
# See Backend_PRD §11 for the full manifest + which vars gate which subsystems.

# ---------------------------------------------------------------------------
# Persistence (git-snapshot commit-pipe · Backend PRD §4)
# ---------------------------------------------------------------------------
# Fine-grained PAT with Contents: Read & Write on THIS repo only.
GH_PAT=
GH_REPO_OWNER=
GH_REPO_NAME=
GH_BRANCH=main

# ---------------------------------------------------------------------------
# Auth · Microsoft Entra ID OIDC (Backend PRD §6)
# ---------------------------------------------------------------------------
# Obtained from BluOr IT after Enterprise App is registered (OQ1/OQ2).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Object ID of the Entra security group whose members are editors.
SIGNAL_EDITOR_GROUP_ID=

# Session cookie signing (256-bit random)
AUTH_JWT_SECRET=
# e.g. signal.bluor.internal — must match the deployed hostname
AUTH_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Vendor headers / secrets
# ---------------------------------------------------------------------------
# Required in the SEC EDGAR User-Agent per A.2
EDGAR_CONTACT_EMAIL=news-tracker@bluorbank.lv

# Cloudflare Worker Nitter proxy (blocked from Vercel egress) — A.9
TWEET_WORKER_URL=
TWEET_WORKER_SECRET=

# Optional — curated FinTwit search; skipped if missing
TWITTERAPI_IO_KEY=

# Optional — consensus fallback where Yahoo lacks; skipped if missing
FMP_API_KEY=

# ---------------------------------------------------------------------------
# LLM enrichment (OFF for v1 · DC8)
# ---------------------------------------------------------------------------
# Ship as "false". Turn on only after monthly ceiling is signed off.
LLM_ENABLED=false
# Only required when LLM_ENABLED=true
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Bearer token Vercel Cron will send. Rotate at will; not in the FE bundle.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Feature toggles
# ---------------------------------------------------------------------------
# When true, Facts with method=bloomberg_manual are stripped from
# role=readonly responses. Default false; flip after legal review (E14).
RESTRICT_BLOOMBERG_TO_EDITORS=false
