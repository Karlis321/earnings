# env
.env*.local
.env

# Frozen monolith — shards + events-index are the source of truth now.
# Kept locally for backfill scripts, but never committed. See
# frontend/server/stores/gitSnapshot.ts for the shard-reconstitution reader.
/data/earnings.json

# Downloaded press releases / filings from scripts/fetch-edgar.mjs.
# These are working copies, never source of truth — the summary JSON
# in data/summaries/ carries the exact source_url. Root-anchored so
# frontend build output HTML (if any) is unaffected.
/fetched/
/*.html
/*.htm

# Ad-hoc working files at repo root — screenshots, log exports,
# scratch metric JSONs from manual /earnings runs. These belong in
# fetched/ but frequently end up at root; ignoring them prevents
# accidental commits.
/*.png
/*.txt
/*-metrics.json
/earnings-karlis123-log-export-*.json
.claude/scheduled_tasks.lock

# Ad-hoc audit run logs — the .json artifact next to each is the
# committed evidence; the .log is just streaming stdout captured
# during a background run.
/scripts/audits/*.log

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel
