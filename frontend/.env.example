# Signal · Earnings & Catalyst Dashboard — env template
# Copy to .env.local for dev; set in the Vercel dashboard for production.
# See Backend_PRD §11 for the full manifest + which vars gate which subsystems.

# ---------------------------------------------------------------------------
# Persistence (git-snapshot commit-pipe · Backend PRD §4)
# ---------------------------------------------------------------------------
# Fine-grained PAT with Contents: Read & Write on THIS repo only.
GH_PAT=
GH_REPO_OWNER=
GH_REPO_NAME=
GH_BRANCH=main

# ---------------------------------------------------------------------------
# Auth (Backend PRD §6)
# ---------------------------------------------------------------------------
# Personal deployment: recommended = Vercel Deployment Protection (no code).
# Fallback: single access code (one env var, one middleware check).
ACCESS_CODE=

# ---------------------------------------------------------------------------
# Vendor headers / secrets
# ---------------------------------------------------------------------------
# Required in the SEC EDGAR User-Agent per A.2 — any real email address works.
EDGAR_CONTACT_EMAIL=your-email@example.com

# Cloudflare Worker Nitter proxy (blocked from Vercel egress) — A.9
TWEET_WORKER_URL=
TWEET_WORKER_SECRET=

# Optional — curated FinTwit search; skipped if missing
TWITTERAPI_IO_KEY=

# Optional — consensus fallback where Yahoo lacks; skipped if missing
FMP_API_KEY=

# ---------------------------------------------------------------------------
# LLM enrichment (OFF for v1 · DC8)
# ---------------------------------------------------------------------------
# Ship as "false". Turn on when you want summaries + news/opinion classification.
LLM_ENABLED=false
# Only required when LLM_ENABLED=true
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Bearer token Vercel Cron will send. Rotate at will; not in the FE bundle.
CRON_SECRET=
